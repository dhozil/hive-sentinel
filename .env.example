# HIVE SENTINEL — env vars untuk Vercel (Settings -> Environment Variables)
# Semua OPSIONAL. Isi lalu Redeploy.

# Endpoint RPC Studionet yang dipakai relay serverless (baca & simulate).
# Default = https://studio.genlayer.com/api
# Ganti bila Anda punya endpoint StudioNet lain yang lebih cepat/terjangkau
# dari region Vercel (mis. gateway/proxy yang ber-CORS).
RPC_URL=https://studio.genlayer.com/api

# Versi Node untuk fungsi (>=18; genlayer-js butuh >=16).
NODE_VERSION=20