{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/common.js", "destination": "/frontend/common.js" },
    { "source": "/api/dashboard", "destination": "/api/dashboard.mjs" },
    { "source": "/api/simulate-attack", "destination": "/api/simulate-attack.mjs" },
    { "source": "/", "destination": "/frontend/index.html" }
  ],
  "functions": {
    "api/*.mjs": { "maxDuration": 60 }
  }
}